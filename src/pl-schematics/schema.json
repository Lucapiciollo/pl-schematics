{
  "$schema": "http://json-schema.org/schema",
  "$id": "PlSchematics",
  "title": "PL Schematics Options",
  "type": "object",
  "properties": {
    "project": {
      "type": "string",
      "description": "Angular project name"
    },
    "nameCompany": {
      "type": "string",
      "description": "Company name",
      "default": "mycompany"
    },
    "namePackage": {
      "type": "string",
      "description": "Generated package/folder name"
    },
    "prefixClass": {
      "type": "string",
      "description": "Class prefix used for generated modules/classes",
      "default": ""
    },
    "browserSupported": {
      "type": "string",
      "description": "Browser support strategy",
      "default": "BROWSER.ALL",
      "enum": [
        "BROWSER.EDG",
        "BROWSER.OPERA",
        "BROWSER.CHROME",
        "BROWSER.IE",
        "BROWSER.FIREFOX",
        "BROWSER.SAFARI",
        "BROWSER.OTHER",
        "BROWSER.ALL"
      ]
    },
    "loginSupportConfiguration": {
      "type": "string",
      "description": "Authentication support",
      "default": "NONE",
      "enum": [
        "NONE",
        "AZURE-ACTIVE-DIRECT"
      ]
    },
    "addSupportBootstrap": {
      "type": "string",
      "description": "Legacy bootstrap support flag",
      "default": "Y",
      "enum": [
        "Y",
        "N"
      ]
    },
    "enableSonarQube": {
      "type": "string",
      "description": "Enable SonarQube support",
      "default": "Y",
      "enum": [
        "Y",
        "N"
      ]
    },
    "architecture": {
      "type": "string",
      "description": "Angular architecture style",
      "default": "classic",
      "enum": [
        "classic",
        "standalone",
        "hybrid"
      ]
    },
    "state": {
      "type": "string",
      "description": "State management strategy",
      "default": "none",
      "enum": [
        "none",
        "ngrx",
        "signals"
      ]
    },
    "http": {
      "type": "string",
      "description": "HTTP layer strategy",
      "default": "interceptor-classic",
      "enum": [
        "none",
        "interceptor-classic",
        "interceptor-functional"
      ]
    },
    "ui": {
      "type": "string",
      "description": "UI framework",
      "default": "bootstrap",
      "enum": [
        "none",
        "bootstrap",
        "material",
        "ux-directives"
      ]
    },
    "i18n": {
      "type": "string",
      "description": "Internationalization strategy",
      "default": "ngx-translate",
      "enum": [
        "none",
        "ngx-translate",
        "angular-localize"
      ]
    },
    "includeDocumentation": {
      "type": "boolean",
      "description": "Include generated documentation files",
      "default": false
    },
    "logging": {
      "type": "string",
      "description": "Logging strategy",
      "default": "console",
      "enum": [
        "none",
        "console",
        "advanced"
      ]
    },
    "mockApi": {
      "type": "string",
      "description": "Mock API strategy",
      "default": "none",
      "enum": [
        "none",
        "json-server",
        "node-express"
      ]
    },
    "ci": {
      "type": "string",
      "description": "CI/CD pipeline support",
      "default": "none",
      "enum": [
        "none",
        "github-actions",
        "azure-devops"
      ]
    },
    "tests": {
      "type": "string",
      "description": "Testing strategy",
      "default": "jasmine",
      "enum": [
        "none",
        "jasmine",
        "jest",
        "vitest"
      ]
    },
    "docker": {
      "type": "boolean",
      "description": "Add Docker support",
      "default": false
    },
    "strict": {
      "type": "boolean",
      "description": "Enable stricter generated configuration",
      "default": false
    }
  },
  "required": [
    "namePackage"
  ]
}