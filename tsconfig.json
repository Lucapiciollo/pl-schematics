{
  "compilerOptions": {
    "lib": ["es2022"],
    "declaration": true,
    "module": "node16",
    "moduleResolution": "node16",
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitAny": true,
    "noImplicitThis": true,
    "noUnusedParameters": true,
    "noUnusedLocals": true,
    "removeComments": true,
    "rootDir": "src/",
    "skipLibCheck": true,
    "sourceMap": false,
    "strictNullChecks": true,
    "target": "es2022",
    "types": ["node"]
  },
  "include": ["src/**/*"],
  "exclude": ["src/*/files/**/*", "src/**/documentation/**/*"]
}
