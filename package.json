{
  "name": "pl-schematics",
  "version": "2.4.14",
  "description": "Standardize Angular project template with PL schematics",
  "schematics": "./src/collection.json",
  "keywords": [
    "schematics",
    "angular",
    "angular-devkit",
    "template",
    "generator"
  ],
  "author": "@l.piciollo",
  "license": "MIT",
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && jasmine src/**/*_spec.js",
    "test:schematic": "npm run build && schematics .:pl-schematics --namePackage=my-app-template --dry-run",
    "test:schematic:full": "npm run build && schematics .:pl-schematics --namePackage=my-app-template --state=ngrx --nameCompany=PL --architecture=classic --state=none --http=interceptor-classic --ui=bootstrap --i18n=ngx-translate --logging=console --mockApi=none --ci=none --tests=jasmine  --ui=material --strict=false --dry-run",
    "release-patch": "npm --no-git-tag-version version patch && npm run build",
    "release-minor": "npm --no-git-tag-version version minor && npm run build",
    "release-major": "npm --no-git-tag-version version major && npm run build",
    "deps:check": "node tools/update-dependencies.interactive.js",
    "deps:update": "node tools/update-dependencies.interactive.js && npm install"
  },
  "dependencies": {
    "@angular-devkit/schematics": ">=8.0.0",
    "@angular/core": "^21.2.14",
    "chalk": "4.1.0",
    "shelljs": "0.8.4"
  },
  "devDependencies": {
    "@angular-devkit/core": ">=19.0.0",
    "@angular-devkit/schematics": ">=19.0.0",
    "@angular-devkit/schematics-cli": ">=19.0.0",
    "@types/jasmine": ">=3.3.9",
    "@types/node": ">=8.0.31",
    "jasmine": ">=3.3.1",
    "schematics-utilities": "^2.0.3",
    "ts-node": "^10.9.2",
    "typescript": "^4.9.5"
  },
  "peerDependencies": {
    "@angular-devkit/schematics": ">=8.0.0",
    "pl-core-utils-library": "^2.1.3"
 },
  "engines": {
    "node": ">=10.13.0"
  }
}
